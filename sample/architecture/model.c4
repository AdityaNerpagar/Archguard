// Relationships are the ALLOWED dependencies.
// Anything not drawn here is not allowed.

specification {
  element system
  element container
}

model {
  shop = system 'Shop' {
    description 'A small online shop'
    metadata {
      service 'shop'
    }

    web = container 'Web app' {
      description 'Pages the customer sees'
      metadata {
        code 'src/web'
      }
    }

    orders = container 'Orders' {
      description 'Places and tracks orders'
      metadata {
        code 'src/orders'
      }
    }

    db = container 'Database access' {
      description 'Reads and writes stored data'
      metadata {
        code 'src/db'
      }
    }

    web -> orders 'places orders through'
    orders -> db 'stores orders in'
  }

  database = system 'Postgres database' {
    description 'Stores orders'
    metadata {
      service 'postgres'
    }
  }

  payments = system 'Payments provider' {
    description 'Charges cards (a mock in development)'
    metadata {
      service 'payments-mock'
    }
  }

  analytics = system 'Analytics' {
    description 'Collects usage events'
  }

  shop.db -> database 'reads and writes'
  shop.orders -> payments 'charges cards through'
}

views {
  view index {
    title 'Shop'
    include shop, shop.*, database, payments, analytics
  }
}
